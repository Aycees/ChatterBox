POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRES_DB
DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5433/POSTGRES_DB
APP_DATABASE_URL=postgresql+asyncpg://app_user:APP_USER_PASSWORD@localhost:5433/POSTGRES_DB
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_USER_PASSWORD=<generate one, e.g. python -c "import secrets; print(secrets.token_hex(16))">

